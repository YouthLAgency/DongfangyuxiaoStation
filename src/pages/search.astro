---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="站内搜索" description="搜索本站理论文章、文艺作品、期刊与工具。">
  <section class="max-w-3xl mx-auto px-4 py-12">
    <header class="mb-8">
      <h1 class="text-4xl font-bold mb-3">站内搜索</h1>
      <p class="text-gray-600">搜索理论文章、文艺作品、期刊、概念与工具。</p>
    </header>

    <div
      id="search"
      data-pagefind-ui
      class="bg-white rounded-lg shadow p-6"
    >
      <p class="text-sm text-gray-500">搜索索引正在加载……</p>
    </div>

    <p class="mt-6 text-xs text-gray-500">
      ⓘ 搜索功能由 <a href="https://pagefind.app/" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">Pagefind</a> 提供，所有搜索均在浏览器本地完成，不上传任何数据。
    </p>
  </section>
</BaseLayout>

<link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
<script is:inline src="/pagefind/pagefind-ui.js"></script>
<script is:inline>
  window.addEventListener('DOMContentLoaded', () => {
    if (window.PagefindUI) {
      new PagefindUI({
        element: '#search',
        translations: {
          placeholder: '搜索本站内容……',
          zero_results: '未找到匹配结果',
          many_results: '找到 [count] 条结果',
          one_result: '找到 1 条结果',
          searching: '搜索中……',
        },
        showImages: false,
        showSubResults: true,
        excerptLength: 14,
      });
    }
  });
</script>
