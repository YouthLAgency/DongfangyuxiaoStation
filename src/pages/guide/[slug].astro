---
import ReaderLayout from '../../layouts/ReaderLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const guides = await getCollection('guide', ({ data }) => !data.draft);
  return guides.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await post.render();

const toc = headings
  .filter((h) => h.depth === 2 || h.depth === 3)
  .map((h) => ({ text: h.text, depth: h.depth, slug: h.slug }));
---

<ReaderLayout
  title={post.data.title}
  description={post.data.description}
  sidebarTitle="本页目录"
  toc={toc}
  meta={[
    { label: '作者', value: post.data.author },
    { label: '类型', value: post.data.type },
    {
      label: '日期',
      value: post.data.date.toLocaleDateString('zh-CN'),
    },
  ]}
>
  <Content />

  <div slot="footer">
    <a
      href="/guide/"
      class="inline-block text-sm text-primary hover:opacity-80 hover:no-underline"
    >
      ← 返回入门指南
    </a>
    {post.data.tags.length ? (
      <div class="mt-4 flex flex-wrap gap-2">
        {post.data.tags.map((tag) => (
          <span class="text-xs bg-gray-100 text-gray-600 px-3 py-1 rounded-full">
            #{tag}
          </span>
        ))}
      </div>
    ) : null}
  </div>
</ReaderLayout>
