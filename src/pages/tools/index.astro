---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="工具导航" description="学习工具、资料库、在线辞典与协作平台推荐。">
  <section class="max-w-3xl mx-auto px-4 py-12">
    <h1 class="text-4xl font-bold mb-6">工具导航</h1>
    <p class="text-gray-600 mb-8">学习工具与资料库导航，建设中。</p>
    <div class="bg-white rounded-lg shadow p-8 text-center text-gray-500">
      <p class="text-lg mb-2">🚧 建设中</p>
      <p class="text-sm">本板块将在第三阶段完成。</p>
    </div>
  </section>
</BaseLayout>
