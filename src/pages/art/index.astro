---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="文艺阵地" description="左翼青年的诗歌、散文、小说、评论与美术创作。">
  <section class="max-w-3xl mx-auto px-4 py-12">
    <h1 class="text-4xl font-bold mb-6">文艺阵地</h1>
    <p class="text-gray-600 mb-8">文艺作品征集与展示板块，建设中。</p>
    <div class="bg-white rounded-lg shadow p-8 text-center text-gray-500">
      <p class="text-lg mb-2">🚧 建设中</p>
      <p class="text-sm">本板块将在第三阶段完成，届时将开放投稿通道。</p>
    </div>
  </section>
</BaseLayout>
