---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="后台管理 · 东方欲晓" description="东方欲晓通讯站后台管理系统。">
  <section class="max-w-content mx-auto px-4 py-10">
    <header class="mb-8">
      <h1 class="text-3xl font-bold mb-2 text-ink">后台管理</h1>
      <p class="text-gray-600">管理各板块内容，一键提交到 GitHub 仓库。</p>
    </header>

    <!-- 配置状态提示 -->
    <div id="config-status" class="mb-6 p-4 rounded-lg bg-gold bg-opacity-20 border border-gold hidden">
      <p class="text-sm text-ink">
        ⚠ 尚未配置 GitHub 仓库信息。请先前往
        <a href="/admin/settings/" class="text-primary font-bold hover:underline">设置页</a>
        配置 Token、仓库所有者与仓库名。
      </p>
    </div>

    <!-- 板块快捷入口 -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 mb-10">
      <a href="/admin/guide/" class="block bg-white rounded-lg shadow hover:shadow-lg transition-shadow p-6 border-l-4 border-primary hover:no-underline">
        <div class="flex items-center justify-between">
          <h3 class="text-lg font-bold text-ink">入门指南</h3>
          <span class="text-2xl">📖</span>
        </div>
        <p class="text-sm text-gray-500 mt-1">阅读路径、书单、招募</p>
        <p id="count-guide" class="text-xs text-gray-400 mt-2">加载中…</p>
      </a>

      <a href="/admin/articles/" class="block bg-white rounded-lg shadow hover:shadow-lg transition-shadow p-6 border-l-4 border-primary hover:no-underline">
        <div class="flex items-center justify-between">
          <h3 class="text-lg font-bold text-ink">理论文章</h3>
          <span class="text-2xl">⚑</span>
        </div>
        <p class="text-sm text-gray-500 mt-1">经典著作、专题文章</p>
        <p id="count-articles" class="text-xs text-gray-400 mt-2">加载中…</p>
      </a>

      <a href="/admin/concepts/" class="block bg-white rounded-lg shadow hover:shadow-lg transition-shadow p-6 border-l-4 border-primary hover:no-underline">
        <div class="flex items-center justify-between">
          <h3 class="text-lg font-bold text-ink">概念词典</h3>
          <span class="text-2xl">📚</span>
        </div>
        <p class="text-sm text-gray-500 mt-1">马哲、政经、科社</p>
        <p id="count-concepts" class="text-xs text-gray-400 mt-2">加载中…</p>
      </a>

      <a href="/admin/art/" class="block bg-white rounded-lg shadow hover:shadow-lg transition-shadow p-6 border-l-4 border-gold hover:no-underline">
        <div class="flex items-center justify-between">
          <h3 class="text-lg font-bold text-ink">文艺阵地</h3>
          <span class="text-2xl">✎</span>
        </div>
        <p class="text-sm text-gray-500 mt-1">诗歌、散文、小说、美术</p>
        <p id="count-art" class="text-xs text-gray-400 mt-2">加载中…</p>
      </a>

      <a href="/admin/journals/" class="block bg-white rounded-lg shadow hover:shadow-lg transition-shadow p-6 border-l-4 border-gold hover:no-underline">
        <div class="flex items-center justify-between">
          <h3 class="text-lg font-bold text-ink">★ 期刊通讯</h3>
          <span class="text-2xl">📰</span>
        </div>
        <p class="text-sm text-gray-500 mt-1">周刊、月刊、文艺报</p>
        <p id="count-journals" class="text-xs text-gray-400 mt-2">加载中…</p>
      </a>

      <a href="/admin/tools/" class="block bg-white rounded-lg shadow hover:shadow-lg transition-shadow p-6 border-l-4 border-primary hover:no-underline">
        <div class="flex items-center justify-between">
          <h3 class="text-lg font-bold text-ink">左翼工具</h3>
          <span class="text-2xl">🧰</span>
        </div>
        <p class="text-sm text-gray-500 mt-1">加密、安全、导航</p>
        <p id="count-tools" class="text-xs text-gray-400 mt-2">加载中…</p>
      </a>
    </div>

    <!-- 联络站 + 设置 -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <a href="/admin/contact/" class="block bg-white rounded-lg shadow hover:shadow-lg transition-shadow p-6 border-l-4 border-gold hover:no-underline">
        <div class="flex items-center justify-between">
          <h3 class="text-lg font-bold text-ink">★ 联络站</h3>
          <span class="text-2xl">✉</span>
        </div>
        <p class="text-sm text-gray-500 mt-1">组织表、联系方式、投稿通道</p>
      </a>

      <a href="/admin/settings/" class="block bg-paper-dark rounded-lg shadow hover:shadow-lg transition-shadow p-6 border-l-4 border-gray-400 hover:no-underline">
        <div class="flex items-center justify-between">
          <h3 class="text-lg font-bold text-ink">⚙ 设置</h3>
          <span class="text-2xl">⚙</span>
        </div>
        <p class="text-sm text-gray-500 mt-1">GitHub Token、仓库配置</p>
      </a>
    </div>

    <!-- 使用说明 -->
    <div class="mt-10 bg-white rounded-lg shadow p-6">
      <h2 class="text-xl font-bold mb-3 text-ink">使用说明</h2>
      <ol class="text-sm text-gray-600 space-y-2 list-decimal list-inside">
        <li>前往 <a href="/admin/settings/" class="text-primary hover:underline">设置</a> 填入 GitHub Token（需 repo 权限）、仓库所有者与仓库名</li>
        <li>点击上方板块卡片进入对应内容列表</li>
        <li>在列表页可查看、编辑、删除已有内容，或点击"新增"创建新内容</li>
        <li>编辑页填写表单后点击"提交到 GitHub"，内容将直接写入仓库对应目录</li>
        <li>提交后 Cloudflare Pages 会自动重新构建部署</li>
      </ol>
    </div>
  </section>
</BaseLayout>

<script is:inline src="/admin-utils.js"></script>
<script is:inline>
(function () {
  if (window.__adminDashboardInit) return;
  window.__adminDashboardInit = true;

  const { GitHub } = window.AdminUtils;

  // 检查配置
  if (!GitHub.isConfigured()) {
    document.getElementById('config-status').classList.remove('hidden');
  }

  // 加载各板块文件数量
  const collections = ['guide', 'articles', 'concepts', 'art', 'journals', 'tools'];
  const pathMap = {
    guide: 'src/content/guide',
    articles: 'src/content/articles',
    concepts: 'src/content/concepts',
    art: 'src/content/art',
    journals: 'src/content/journals',
    tools: 'src/content/tools',
  };

  collections.forEach((key) => {
    const el = document.getElementById(`count-${key}`);
    if (!el) return;
    if (!GitHub.isConfigured()) {
      el.textContent = '未配置 GitHub';
      return;
    }
    GitHub.listFiles(pathMap[key])
      .then((files) => {
        el.textContent = `共 ${files.length} 篇`;
      })
      .catch((err) => {
        el.textContent = `加载失败：${err.message}`;
      });
  });
})();
</script>
