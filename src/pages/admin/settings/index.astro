---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout title="设置 · 后台管理" description="配置 GitHub Token 与仓库信息。">
  <section class="max-w-2xl mx-auto px-4 py-10">
    <div class="mb-6">
      <p class="text-sm text-gray-500 mb-1">
        <a href="/admin/" class="hover:underline">后台首页</a> / 设置
      </p>
      <h1 class="text-3xl font-bold text-ink">设置</h1>
    </div>

    <div class="bg-white rounded-lg shadow p-6 space-y-5">
      <div>
        <label class="block text-sm font-semibold text-ink mb-1">
          GitHub Personal Access Token <span class="text-primary">*</span>
        </label>
        <input
          id="token"
          type="password"
          placeholder="ghp_xxxxxxxxxxxxxxxxxxxx"
          class="w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:border-primary font-mono text-sm"
        />
        <p class="text-xs text-gray-500 mt-1">
          需 <code class="bg-paper-dark px-1 rounded">repo</code> 权限。Token 仅存于浏览器 localStorage，不会上传到任何服务器。
          <a href="https://github.com/settings/tokens" target="_blank" rel="noopener" class="text-primary hover:underline">创建 Token →</a>
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-semibold text-ink mb-1">
            仓库所有者 (Owner) <span class="text-primary">*</span>
          </label>
          <input
            id="owner"
            type="text"
            placeholder="YouthAgency"
            class="w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:border-primary"
          />
        </div>
        <div>
          <label class="block text-sm font-semibold text-ink mb-1">
            仓库名 (Repo) <span class="text-primary">*</span>
          </label>
          <input
            id="repo"
            type="text"
            placeholder="DongfangyuxiaoStation"
            class="w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:border-primary"
          />
        </div>
      </div>

      <div>
        <label class="block text-sm font-semibold text-ink mb-1">分支 (Branch)</label>
        <input
          id="branch"
          type="text"
          placeholder="main"
          class="w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:border-primary"
        />
        <p class="text-xs text-gray-500 mt-1">默认为 main</p>
      </div>

      <div class="flex gap-3 pt-2">
        <button
          id="save-btn"
          type="button"
          class="px-5 py-2 bg-primary text-white rounded hover:opacity-90 text-sm"
        >
          保存配置
        </button>
        <button
          id="test-btn"
          type="button"
          class="px-5 py-2 border border-gray-300 text-ink rounded hover:bg-paper-dark text-sm"
        >
          测试连接
        </button>
        <button
          id="clear-btn"
          type="button"
          class="px-5 py-2 border border-red-300 text-red-600 rounded hover:bg-red-50 text-sm"
        >
          清除配置
        </button>
      </div>

      <div id="status" class="text-sm hidden"></div>
    </div>

    <div class="mt-6 bg-paper-dark rounded-lg p-5 text-sm text-gray-600">
      <h3 class="font-bold text-ink mb-2">安全须知</h3>
      <ul class="space-y-1 list-disc list-inside">
        <li>Token 仅存储在你当前浏览器的 localStorage 中</li>
        <li>请勿在公共设备上保存 Token</li>
        <li>建议使用 Fine-grained Token，仅授予目标仓库的 Contents 读写权限</li>
        <li>所有 API 请求直接发往 api.github.com，不经过任何中间服务器</li>
      </ul>
    </div>
  </section>
</BaseLayout>

<script is:inline src="/admin-utils.js"></script>
<script is:inline>
(function () {
  if (window.__adminSettingsInit) return;
  window.__adminSettingsInit = true;

  const { GitHub } = window.AdminUtils;

  const tokenEl = document.getElementById('token');
  const ownerEl = document.getElementById('owner');
  const repoEl = document.getElementById('repo');
  const branchEl = document.getElementById('branch');
  const statusEl = document.getElementById('status');

  // 加载已有配置
  const cfg = GitHub.getConfig();
  tokenEl.value = cfg.token;
  ownerEl.value = cfg.owner;
  repoEl.value = cfg.repo;
  branchEl.value = cfg.branch;

  function showStatus(msg, isError) {
    statusEl.textContent = msg;
    statusEl.className = `text-sm mt-3 ${isError ? 'text-red-600' : 'text-green-600'}`;
    statusEl.classList.remove('hidden');
  }

  document.getElementById('save-btn').addEventListener('click', () => {
    GitHub.setConfig({
      token: tokenEl.value.trim(),
      owner: ownerEl.value.trim(),
      repo: repoEl.value.trim(),
      branch: branchEl.value.trim() || 'main',
    });
    showStatus('✓ 配置已保存');
  });

  document.getElementById('test-btn').addEventListener('click', async () => {
    GitHub.setConfig({
      token: tokenEl.value.trim(),
      owner: ownerEl.value.trim(),
      repo: repoEl.value.trim(),
      branch: branchEl.value.trim() || 'main',
    });
    if (!GitHub.isConfigured()) {
      showStatus('✗ 请填写 Token、Owner 和 Repo', true);
      return;
    }
    try {
      const cfg = GitHub.getConfig();
      const data = await GitHub.api('GET', `/repos/${cfg.owner}/${cfg.repo}`);
      showStatus(`✓ 连接成功！仓库：${data.full_name}（默认分支：${data.default_branch}）`);
    } catch (err) {
      showStatus(`✗ 连接失败：${err.message}`, true);
    }
  });

  document.getElementById('clear-btn').addEventListener('click', () => {
    if (!confirm('确定清除所有配置？')) return;
    GitHub.setConfig({ token: '', owner: '', repo: '', branch: 'main' });
    tokenEl.value = '';
    ownerEl.value = '';
    repoEl.value = '';
    branchEl.value = 'main';
    showStatus('✓ 配置已清除');
  });
})();
</script>
