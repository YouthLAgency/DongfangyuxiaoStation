---
import BaseLayout from '../../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  const collections = ['guide', 'articles', 'concepts', 'art', 'journals', 'tools'];
  return collections.map((collection) => ({
    params: { collection },
  }));
}

const { collection } = Astro.params;
---

<BaseLayout title={`内容列表 · 后台管理`} description="管理板块内容列表。">
  <section class="max-w-content mx-auto px-4 py-10">
    <div class="flex items-center justify-between mb-6">
      <div>
        <p class="text-sm text-gray-500 mb-1">
          <a href="/admin/" class="hover:underline">后台首页</a> / <span id="crumb-label">加载中…</span>
        </p>
        <h1 id="page-title" class="text-3xl font-bold text-ink">加载中…</h1>
      </div>
      <div class="flex items-center gap-3">
        {collection === 'journals' && (
          <button
            type="button"
            id="sync-btn"
            class="px-5 py-2 bg-gold text-ink rounded hover:opacity-90 text-sm font-semibold"
          >
            🔄 从仓库同步
          </button>
        )}
        <a
          id="new-btn"
          href={`/admin/${collection}/new`}
          class="px-5 py-2 bg-primary text-white rounded hover:opacity-90 text-sm hover:no-underline"
        >
          + 新增
        </a>
      </div>
    </div>

    {collection === 'journals' && (
      <div id="sync-status" class="hidden mb-4 p-4 rounded-lg bg-paper-dark text-sm"></div>
    )}

    <!-- 搜索框 -->
    <div class="mb-4">
      <input
        id="search"
        type="text"
        placeholder="搜索标题…"
        class="w-full md:w-80 border border-gray-300 rounded px-3 py-2 focus:outline-none focus:border-primary"
      />
    </div>

    <!-- 列表 -->
    <div id="list-container" class="bg-white rounded-lg shadow overflow-hidden">
      <p class="p-6 text-gray-500 text-center">加载中…</p>
    </div>
  </section>
</BaseLayout>

<script is:inline src="/admin-utils.js"></script>
<script is:inline>
(function () {
  if (window.__adminListInit) return;
  window.__adminListInit = true;

  const { GitHub, Schemas } = window.AdminUtils;
  const collection = window.location.pathname.split('/')[2];
  const schema = Schemas[collection];

  if (!schema) {
    document.getElementById('page-title').textContent = '未知板块';
    document.getElementById('list-container').innerHTML =
      '<p class="p-6 text-red-600 text-center">未找到该板块配置</p>';
    return;
  }

  document.getElementById('page-title').textContent = schema.label;
  document.getElementById('crumb-label').textContent = schema.label;
  document.title = `${schema.label} · 后台管理`;

  const listContainer = document.getElementById('list-container');
  const searchInput = document.getElementById('search');
  let allFiles = [];

  function getFieldValue(data, name) {
    return data[name] !== undefined ? String(data[name]) : '—';
  }

  function renderList(files) {
    if (files.length === 0) {
      listContainer.innerHTML = '<p class="p-6 text-gray-500 text-center">暂无内容，点击右上角"新增"创建</p>';
      return;
    }

    // 根据板块决定显示列
    let cols = [];
    if (collection === 'concepts') {
      cols = [
        { label: '术语', key: 'term' },
        { label: '分类', key: 'category' },
      ];
    } else if (collection === 'tools') {
      cols = [
        { label: '名称', key: 'name' },
        { label: '分类', key: 'type' },
        { label: '推荐', key: 'recommended' },
      ];
    } else if (collection === 'journals') {
      cols = [
        { label: '标题', key: 'title' },
        { label: '期号', key: 'issue' },
        { label: '类型', key: 'type' },
        { label: '日期', key: 'date' },
      ];
    } else {
      cols = [
        { label: '标题', key: 'title' },
        { label: '类型/分类', key: schema.fields.find((f) => f.type === 'enum')?.name || 'type' },
        { label: '日期', key: 'date' },
      ];
    }

    let html = '<table class="w-full text-sm"><thead class="bg-paper-dark text-ink"><tr>';
    cols.forEach((c) => {
      html += `<th class="text-left px-4 py-3 font-bold">${c.label}</th>`;
    });
    html += '<th class="text-right px-4 py-3 font-bold">操作</th></tr></thead><tbody class="divide-y divide-gray-100">';

    files.forEach((f) => {
      const { data } = window.AdminUtils.Markdown.parse(f.content);
      html += '<tr class="hover:bg-paper">';
      cols.forEach((c) => {
        let val = getFieldValue(data, c.key);
        if (c.key === 'recommended') val = val === 'true' ? '✓' : '—';
        html += `<td class="px-4 py-3${c.key === 'title' || c.key === 'term' || c.key === 'name' ? ' font-semibold text-ink' : ' text-gray-600'}">${val}</td>`;
      });
      const slug = f.name.replace(/\.md$/, '');
      html += `<td class="px-4 py-3 text-right whitespace-nowrap">
        <a href="/admin/${collection}/${slug}" class="text-primary hover:underline mr-3">编辑</a>
        <button data-slug="${slug}" class="btn-delete text-red-600 hover:underline">删除</button>
      </td>`;
      html += '</tr>';
    });

    html += '</tbody></table>';
    listContainer.innerHTML = html;

    // 绑定删除
    listContainer.querySelectorAll('.btn-delete').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const slug = btn.getAttribute('data-slug');
        if (!confirm(`确定删除「${slug}」？此操作不可撤销。`)) return;
        try {
          const path = `${schema.path}/${slug}.md`;
          const { sha } = await GitHub.getFile(path);
          await GitHub.deleteFile(path, sha, `删除 ${collection}/${slug}.md`);
          alert('删除成功');
          loadFiles();
        } catch (err) {
          alert('删除失败：' + err.message);
        }
      });
    });
  }

  async function loadFiles() {
    if (!GitHub.isConfigured()) {
      listContainer.innerHTML =
        '<p class="p-6 text-center"><a href="/admin/settings/" class="text-primary hover:underline">请先配置 GitHub 仓库信息</a></p>';
      return;
    }
    try {
      listContainer.innerHTML = '<p class="p-6 text-gray-500 text-center">加载中…</p>';
      const files = await GitHub.listFiles(schema.path);
      // 预取内容以解析 frontmatter
      allFiles = await Promise.all(
        files.map(async (f) => {
          const { content } = await GitHub.getFile(`${schema.path}/${f.name}`);
          return { name: f.name, content };
        })
      );
      renderList(allFiles);
    } catch (err) {
      listContainer.innerHTML = `<p class="p-6 text-red-600 text-center">加载失败：${err.message}</p>`;
    }
  }

  // 搜索过滤
  searchInput.addEventListener('input', () => {
    const q = searchInput.value.trim().toLowerCase();
    if (!q) {
      renderList(allFiles);
      return;
    }
    const filtered = allFiles.filter((f) => {
      const { data } = window.AdminUtils.Markdown.parse(f.content);
      const searchTarget = Object.values(data).join(' ').toLowerCase();
      return searchTarget.includes(q);
    });
    renderList(filtered);
  });

  // ========== 刊物仓库同步 ==========
  const syncBtn = document.getElementById('sync-btn');
  const syncStatus = document.getElementById('sync-status');

  if (syncBtn) {
    function log(msg, isError) {
      syncStatus.classList.remove('hidden');
      syncStatus.innerHTML += `<div class="${isError ? 'text-red-600' : 'text-ink'}">${msg}</div>`;
    }

    function getJournalType(dirName) {
      const n = dirName.toLowerCase();
      if (n.includes('周刊') || n.includes('weekly')) return '周刊';
      if (n.includes('月刊') || n.includes('monthly')) return '月刊';
      return '特刊';
    }

    function extractIssue(filename) {
      const base = filename.replace(/\.[^.]+$/, '');
      let m = base.match(/第([一二三四五六七八九十百千零\d]+)期/);
      if (m) return `第${m[1]}期`;
      m = base.match(/([一二三四五六七八九十百千零]+)期/);
      if (m) return `第${m[1]}期`;
      m = base.match(/(\d+)/);
      return m ? `第${m[1]}期` : base;
    }

    function extractDate(filename) {
      const base = filename.replace(/\.[^.]+$/, '');
      const cnMonth = { 一:1,二:2,三:3,四:4,五:5,六:6,七:7,八:8,九:9,十:10,十一:11,十二:12 };
      let m = base.match(/(\d{4})-(\d{1,2})-(\d{1,2})/);
      if (m) return `${m[1]}-${m[2].padStart(2,'0')}-${m[3].padStart(2,'0')}`;
      m = base.match(/(\d{4})(\d{2})(\d{2})/);
      if (m) return `${m[1]}-${m[2]}-${m[3]}`;
      m = base.match(/(\d{4})年([一二三四五六七八九十]+|\d{1,2})月/);
      if (m) {
        let mo = m[2];
        if (cnMonth[mo]) mo = cnMonth[mo];
        return `${m[1]}-${String(mo).padStart(2,'0')}-01`;
      }
      m = base.match(/(\d{4})/);
      if (m) return `${m[1]}-01-01`;
      return new Date().toISOString().slice(0, 10);
    }

    function slugify(dirName, filename) {
      const type = getJournalType(dirName) === '周刊' ? 'weekly' : 'monthly';
      const base = filename.replace(/\.[^.]+$/, '')
        .replace(/[\s_]+/g, '-')
        .replace(/[^\w\u4e00-\u9fa5-]/g, '')
        .toLowerCase();
      return `${type}-${base}`;
    }

    function generateMd(dirName, filename, type) {
      const issue = extractIssue(filename);
      const title = `${dirName}·${issue}`;
      const isPdf = /\.pdf$/i.test(filename);
      const pdfLocal = isPdf ? `/journals/${dirName}/${filename}` : '';
      const date = extractDate(filename);
      const fm = [
        '---',
        `title: "${title}"`,
        `issue: "${issue}"`,
        `description: "${dirName}${issue}——机关刊物电子版。"`,
        `date: ${date}`,
        `type: ${type}`,
        `onlineReadable: true`,
      ];
      if (pdfLocal) fm.push(`pdfLocal: "${pdfLocal}"`);
      fm.push(
        `tags:`,
        `  - ${type}`,
        `  - 机关刊物`,
        `draft: false`,
        '---',
        '',
        isPdf ? `本文为 PDF 在线阅读版，请使用上方 PDF 阅读器浏览完整内容。` : '',
      );
      return fm.join('\n');
    }

    syncBtn.addEventListener('click', async () => {
      if (!GitHub.isConfigured()) {
        alert('请先在设置页配置 GitHub 仓库信息');
        return;
      }
      syncStatus.classList.remove('hidden');
      syncStatus.innerHTML = '';
      syncBtn.disabled = true;
      syncBtn.textContent = '同步中…';

      try {
        log('📡 正在读取 ZhenliWeekly 仓库结构…');
        const rootRes = await fetch('https://api.github.com/repos/YouthLAgency/ZhenliWeekly/contents?ref=main');
        if (!rootRes.ok) throw new Error(`HTTP ${rootRes.status}`);
        const dirs = (await rootRes.json()).filter((i) => i.type === 'dir');
        log(`发现 ${dirs.length} 个文件夹：${dirs.map((d) => d.name).join('、')}`);

        // 收集所有期刊文件
        const items = [];
        for (const dir of dirs) {
          const type = getJournalType(dir.name);
          const filesRes = await fetch(`https://api.github.com/repos/YouthLAgency/ZhenliWeekly/contents/${encodeURIComponent(dir.name)}?ref=main`);
          const files = await filesRes.json();
          const skipNames = new Set(['docs.md', 'readme.md', 'README.md', 'index.md', '.gitkeep']);
          const docs = files.filter((f) => f.type === 'file' && /\.(pdf|md)$/i.test(f.name) && !skipNames.has(f.name));
          log(`📁 ${dir.name}（${type}）：${docs.length} 个文件`);
          for (const f of docs) {
            items.push({ dirName: dir.name, filename: f.name, type, slug: slugify(dir.name, f.name) });
          }
        }

        if (items.length === 0) {
          log('⚠ 未找到期刊文件');
          return;
        }

        // 获取现有 journals 文件
        const existing = await GitHub.listFiles('src/content/journals');
        const existingNames = new Set(existing.map((f) => f.name));
        const expectedNames = new Set(items.map((i) => `${i.slug}.md`));

        // 删除过期
        for (const f of existing) {
          if (!expectedNames.has(f.name)) {
            log(`🗑 删除过期：${f.name}`);
            const { sha } = await GitHub.getFile(`src/content/journals/${f.name}`);
            await GitHub.deleteFile(`src/content/journals/${f.name}`, sha, `同步删除过期期刊 ${f.name}`);
          }
        }

        // 写入/更新（先上传 PDF，再写 markdown）
        let created = 0, updated = 0;
        for (const item of items) {
          const isPdf = /\.pdf$/i.test(item.filename);

          // 上传 PDF 到 public/journals/
          if (isPdf) {
            const pdfPath = `public/journals/${item.dirName}/${item.filename}`;
            const rawUrl = `https://raw.githubusercontent.com/YouthLAgency/ZhenliWeekly/main/${encodeURIComponent(item.dirName)}/${encodeURIComponent(item.filename)}`;
            try {
              const blob = await fetch(rawUrl).then((r) => r.blob());
              const reader = new FileReader();
              const base64 = await new Promise((resolve) => {
                reader.onload = () => resolve(reader.result.split(',')[1]);
                reader.readAsDataURL(blob);
              });
              let pdfSha = null;
              try {
                const r = await GitHub.getFile(pdfPath);
                pdfSha = r.sha;
              } catch (e) { /* 不存在 */ }
              await GitHub.putFile(pdfPath, base64, `同步期刊 PDF ${item.filename}`, pdfSha, true);
              log(`⬆ 上传 PDF：${item.filename}`);
            } catch (e) {
              log(`✗ PDF 上传失败：${item.filename}（${e.message}）`, true);
            }
          }

          // 写入 journals markdown
          const path = `src/content/journals/${item.slug}.md`;
          const md = generateMd(item.dirName, item.filename, item.type);
          let sha = null;
          try {
            const r = await GitHub.getFile(path);
            sha = r.sha;
            if (r.content === md) {
              log(`⏭ 无变化：${item.slug}.md`);
              continue;
            }
          } catch (e) { /* 新增 */ }
          const isNew = !sha;
          await GitHub.putFile(path, md, `${isNew ? '新增' : '更新'}期刊 ${item.slug}.md`, sha);
          log(`${isNew ? '✨ 新增' : '✏ 更新'}：${item.slug}.md`);
          if (isNew) created++;
          else updated++;
        }

        log(`✅ 同步完成：新增 ${created}，更新 ${updated}`);
        loadFiles();
      } catch (err) {
        log(`❌ 同步失败：${err.message}`, true);
      } finally {
        syncBtn.disabled = false;
        syncBtn.textContent = '🔄 从仓库同步';
      }
    });
  }

  loadFiles();
})();
</script>
