---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="刊物" description="《真理周刊》等电子刊物，记录我们的思考与实践。">
  <section class="max-w-3xl mx-auto px-4 py-12">
    <h1 class="text-4xl font-bold mb-6">刊物</h1>
    <p class="text-gray-600 mb-8">电子刊物阅读板块，建设中。</p>
    <div class="bg-white rounded-lg shadow p-8 text-center text-gray-500">
      <p class="text-lg mb-2">🚧 建设中</p>
      <p class="text-sm">本板块将在第三阶段完成，首期刊物正在筹备中。</p>
    </div>
  </section>
</BaseLayout>
