---
import ReaderLayout from '../../layouts/ReaderLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const journals = await getCollection('journals', ({ data }) => !data.draft);
  return journals.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await post.render();

const toc = headings
  .filter((h) => h.depth === 2 || h.depth === 3)
  .map((h) => ({ text: h.text, depth: h.depth, slug: h.slug }));

const hasPdf = !!post.data.pdfLocal;
---

<ReaderLayout
  title={post.data.title}
  description={post.data.description}
  sidebarTitle="本刊目录"
  toc={toc}
  meta={[
    { label: '期号', value: post.data.issue },
    { label: '类型', value: post.data.type },
    {
      label: '出版日期',
      value: post.data.date.toLocaleDateString('zh-CN'),
    },
  ]}
>
  {hasPdf && (
    <div class="mb-8">
      <div class="flex items-center gap-3 mb-3">
        <button
          type="button"
          id="tab-pdf"
          class="px-4 py-2 bg-primary text-white rounded text-sm font-semibold"
        >
          📄 PDF 版
        </button>
        <button
          type="button"
          id="tab-text"
          class="px-4 py-2 border border-gray-300 text-ink rounded text-sm hover:bg-paper-dark"
        >
          📝 文字版
        </button>
        <span id="pdf-status" class="text-xs text-gray-500">加载中…</span>
      </div>

      <div id="pdf-panel" class="border border-gray-200 rounded-lg overflow-hidden bg-white">
        <div class="aspect-[8.5/11] w-full">
          <iframe
            id="pdf-frame"
            class="w-full h-full"
            style="min-height: 600px;"
            title={`${post.data.title} PDF 在线阅读`}
          ></iframe>
        </div>
      </div>

      <div id="text-panel" class="hidden">
        <Content />
      </div>
    </div>
  )}

  {!hasPdf && <Content />}

  <div slot="footer">
    <div class="flex flex-wrap gap-3">
      {hasPdf && (
        <button
          type="button"
          id="download-pdf-btn"
          class="inline-flex items-center gap-1 px-4 py-2 bg-gold text-ink rounded hover:opacity-90 hover:no-underline text-sm font-semibold"
        >
          ⬇ 下载 PDF
        </button>
      )}
      {post.data.downloadUrl && (
        <a
          href={post.data.downloadUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 px-4 py-2 bg-primary text-white rounded hover:opacity-90 hover:no-underline text-sm"
        >
          ⬇ PDF 下载（外链）
        </a>
      )}
      <a
        href="/journal/"
        class="inline-flex items-center gap-1 px-4 py-2 border border-gray-300 text-ink rounded hover:bg-paper-dark text-sm hover:no-underline"
      >
        ← 返回刊物列表
      </a>
    </div>
    {post.data.tags.length ? (
      <div class="mt-4 flex flex-wrap gap-2">
        {post.data.tags.map((tag) => (
          <span class="text-xs bg-gray-100 text-gray-600 px-3 py-1 rounded-full">
            #{tag}
          </span>
        ))}
      </div>
    ) : null}
  </div>
</ReaderLayout>

{hasPdf && (
  <script is:inline define:vars={{ pdfLocal: post.data.pdfLocal }}>
    (function () {
      // PDF 从本站 Cloudflare CDN 提供，Content-Type: application/pdf，浏览器内嵌预览
      const pdfUrl = pdfLocal;

      const statusEl = document.getElementById('pdf-status');
      const frame = document.getElementById('pdf-frame');
      const tabPdf = document.getElementById('tab-pdf');
      const tabText = document.getElementById('tab-text');
      const pdfPanel = document.getElementById('pdf-panel');
      const textPanel = document.getElementById('text-panel');
      const downloadBtn = document.getElementById('download-pdf-btn');

      frame.src = pdfUrl;
      frame.addEventListener('load', () => {
        statusEl.textContent = '✓ 已加载';
        statusEl.className = 'text-xs text-green-600';
      });
      setTimeout(() => {
        if (statusEl.textContent === '加载中…') {
          statusEl.innerHTML = '加载较慢，可点击 <a href="' + pdfUrl + '" target="_blank" class="text-primary hover:underline">此处</a> 直接打开';
          statusEl.className = 'text-xs text-gray-500';
        }
      }, 8000);

      tabPdf.addEventListener('click', () => {
        tabPdf.className = 'px-4 py-2 bg-primary text-white rounded text-sm font-semibold';
        tabText.className = 'px-4 py-2 border border-gray-300 text-ink rounded text-sm hover:bg-paper-dark';
        pdfPanel.classList.remove('hidden');
        textPanel.classList.add('hidden');
      });
      tabText.addEventListener('click', () => {
        tabText.className = 'px-4 py-2 bg-primary text-white rounded text-sm font-semibold';
        tabPdf.className = 'px-4 py-2 border border-gray-300 text-ink rounded text-sm hover:bg-paper-dark';
        textPanel.classList.remove('hidden');
        pdfPanel.classList.add('hidden');
      });

      if (downloadBtn) {
        downloadBtn.addEventListener('click', () => {
          window.open(pdfUrl, '_blank');
        });
      }
    })();
  </script>
)}
