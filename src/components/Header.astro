---
const navItems = [
  { label: '首页', href: '/' },
  { label: '入门指南', href: '/guide/' },
  { label: '理论中心', href: '/theory/' },
  { label: '文艺阵地', href: '/art/' },
  { label: '刊物', href: '/journal/' },
  { label: '工具导航', href: '/tools/' },
  { label: '关于', href: '/about/' },
  { label: '联络站', href: '/contact/' },
];
const currentPath = Astro.url.pathname;
---

<header class="bg-primary-dark text-white sticky top-0 z-50 shadow-md">
  <div class="max-w-6xl mx-auto px-4">
    <div class="flex items-center justify-between h-16">
      <a href="/" class="flex items-center gap-2 hover:no-underline">
        <span class="text-2xl" aria-hidden="true">★</span>
        <span class="text-xl font-bold tracking-wide">东方欲晓</span>
      </a>

      <!-- 桌面导航 -->
      <nav class="hidden md:flex items-center gap-1">
        {
          navItems.map((item) => {
            const isActive =
              item.href === '/'
                ? currentPath === '/'
                : currentPath.startsWith(item.href);
            return (
              <a
                href={item.href}
                class:list={[
                  'px-3 py-2 rounded text-sm hover:bg-white/10 transition-colors',
                  isActive && 'bg-white/15 font-semibold',
                ]}
              >
                {item.label}
              </a>
            );
          })
        }
      </nav>

      <!-- 移动端菜单按钮 -->
      <details class="md:hidden relative">
        <summary class="list-none cursor-pointer p-2 text-2xl">☰</summary>
        <nav class="absolute right-0 top-full mt-1 bg-primary-dark shadow-lg rounded-bl-lg min-w-[160px] py-2">
          {
            navItems.map((item) => (
              <a
                href={item.href}
                class="block px-4 py-2 text-sm hover:bg-white/10"
              >
                {item.label}
              </a>
            ))
          }
        </nav>
      </details>
    </div>
  </div>
</header>
